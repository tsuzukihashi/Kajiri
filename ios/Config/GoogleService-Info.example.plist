<?xml version="1.0" encoding="UTF-8"?>
<!--
  これは見本です。本物は自分の Firebase プロジェクトにこのアプリ（バンドル ID）を登録して取ってきて、
  ios/Otayori/GoogleService-Info.plist に置いてください（.gitignore 済み。コミットしない）。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>your-firebase-ios-api-key</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.example.Otayori</string>
	<key>PROJECT_ID</key>
	<string>your-firebase-project-id</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
