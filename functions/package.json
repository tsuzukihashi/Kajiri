{
  "name": "kajiri-functions",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
